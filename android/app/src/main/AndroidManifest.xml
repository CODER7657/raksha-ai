<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      RECEIVE_SMS is a Play Console RESTRICTED permission. It requires a
      declaration, a demo video and a justification, and review takes weeks;
      fraud prevention is not an automatic exemption (#29 §6, still unresolved).

      Two consequences are designed for rather than hoped away:
        - the app must be useful without it, which is why the share-to-app
          fallback below is a first-class path and not a stopgap;
        - the permission is requested when the user turns scanning on, never at
          launch. Holding it is not consent to use it - ScanPreferences gates
          the receiver independently.
    -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />

    <!-- API 33+. Without it the warning cannot be shown at all. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      The app is useful on a device with no SMS hardware through the
      share-to-app path, so telephony is not required for installation.
    -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <!--
      allowBackup="false" so scanning preferences never ride out to a cloud
      backup. There is no message content to leak - nothing is persisted - but
      the setting also stops a restored backup from silently re-enabling
      scanning on a device the user never granted it on.

      usesCleartextTraffic="false" is free today and is the point: this app
      makes no network call at all, and the flag turns "we did not add one" into
      "the platform will not let one be added quietly". The Play declaration in
      #39 asserts message content never leaves the device, and that assertion is
      easier to keep true when the platform is enforcing it too.
    -->
    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.RakshaAI">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              The fallback for a refused RECEIVE_SMS declaration: the user
              shares a suspicious message from their messaging app instead.
              Same engine, same verdict, one extra tap.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!--
          There is deliberately no BOOT_COMPLETED receiver, and #82 §6 asked for
          one on the premise that "protection silently stops after a restart".
          Measured on an Android 16 emulator, that premise does not hold:

            10:03:03  Start proc 3031 for broadcast {ai.raksha.app/.sms.SmsReceiver}
            10:03:10  scan complete: 2 rule(s) fired [account_lock, otp_share]

          after `adb reboot`, with the app never opened. The platform restores a
          manifest-declared receiver across a reboot and cold-starts the process
          to deliver the broadcast, so a BOOT_COMPLETED receiver would have
          nothing to do. Adding one would mean requesting RECEIVE_BOOT_COMPLETED
          for no behaviour, on an app whose Play declaration (#39) states it holds
          exactly two permissions.

          Two adjacent gaps a boot receiver would NOT close either, noted so they
          are not confused with this one:

            - Force-stop. An app the user force-stops enters the stopped state and
              receives no broadcasts at all until it is launched again -
              BOOT_COMPLETED included.
            - Direct boot. Between a restart and the first unlock, credential-
              encrypted storage is unavailable and non-directBootAware components
              do not run, so a message arriving in that window is missed. Closing
              that needs android:directBootAware plus device-encrypted storage for
              the scanning preference, not a boot receiver. NOT measured here: the
              emulator auto-unlocks with no PIN set, so the window never occurred.
        -->
        <receiver
            android:name=".sms.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
