<?xml version="1.0" encoding="utf-8"?>
<!--
  Android-only strings. Everything a user reads that also exists on the web now
  lives in frontend/src/i18n/locales/*.json under `android.*` and is generated
  into build/generated/i18nRes at build time (#64), so the phone and the site
  cannot describe the same thing differently.

  What stays here, and why:
    app_name                   brand/launcher identity, not copy
    warning_channel_*          Android notification-channel concept, rendered by
                               system settings; the web has no such surface
    warning_summary*           notification formatting primitives (%1$s)
    warning_reason_bullet      pure formatting
    selected_format            Android positional specifiers (%1$s..%4$s);
                               i18next uses {{name}}, and converting between the
                               two invites a silent mismatch

  Anything else added here should probably go in the web bundles instead.
-->
<resources>
    <string name="app_name">Raksha AI</string>
    <string name="warning_channel_name">Scam warnings</string>
    <string name="warning_channel_description">Warns you when a message looks like a scam. Messages are checked on your phone and are never sent anywhere.</string>
    <string name="warning_summary">From %1$s</string>
    <string name="warning_summary_no_sender">From an unknown sender</string>
    <string name="warning_reason_bullet">• %1$s</string>
    <string name="selected_format">Selected: %1$s · %2$s · %3$s script · %4$s</string>
    <string name="settings_stored_count">%1$d message(s) stored on this phone</string>
</resources>
