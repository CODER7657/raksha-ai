# LLM providers (both free tier — Groq primary, Gemini fallback)
GROQ_API_KEY=
GEMINI_API_KEY=

# Supabase project settings → API
SUPABASE_URL=
# Service role key — backend only, NEVER expose to frontend/browser
SUPABASE_SERVICE_ROLE_KEY=
# Project settings → API → JWT Settings → JWT Secret (used to verify tokens issued to the frontend)
SUPABASE_JWT_SECRET=

# Comma-separated list of allowed frontend origins, no wildcard
ALLOWED_ORIGINS=http://localhost:5173

# --- ElevenLabs TTS (optional) ---
# Leave blank to use the browser's built-in voices only. When set, read-aloud
# uses ElevenLabs and automatically falls back to the browser voice on any
# error or quota exhaustion.
# NOTE: the free plan is ~10,000 credits/month (~1 credit per character) across
# ALL users — that is roughly 30-60 spoken replies per month. Treat as a demo
# feature unless the plan is upgraded.
ELEVENLABS_API_KEY=
# Stock voice confirmed to work on the free plan (Voice Library voices 402).
ELEVENLABS_VOICE_ID=pFZP5JQG7iQjIQuC4Bku
# eleven_v3 covers Gujarati/Odia; eleven_flash_v2_5 is half the credit cost but
# does not officially support them.
ELEVENLABS_MODEL_ID=eleven_v3

# e.g. "10/minute" — protects free LLM quota from abuse
SCAN_RATE_LIMIT=10/minute
CHAT_RATE_LIMIT=15/minute
TTS_RATE_LIMIT=20/minute
