# LLM providers (both free tier — Groq primary, Gemini fallback)
GROQ_API_KEY=
GEMINI_API_KEY=

# Supabase project settings → API
SUPABASE_URL=
# Service role key — backend only, NEVER expose to frontend/browser
SUPABASE_SERVICE_ROLE_KEY=
# Project settings → API → JWT Settings → JWT Secret (used to verify tokens issued to the frontend)
SUPABASE_JWT_SECRET=

# Comma-separated list of allowed frontend origins, no wildcard
ALLOWED_ORIGINS=http://localhost:5173

# --- Text-to-speech (all optional) ---
# With nothing set here, read-aloud uses the browser's own voices. Any failure
# at any point also falls back to the browser voice, so this is safe to leave
# blank.
# "auto" = use Google if its key is set, else ElevenLabs, else disabled.
TTS_PROVIDER=auto

# Google Cloud TTS — RECOMMENDED for this app. It has real native-speaker
# neural voices for gu-IN, hi-IN, mr-IN, bn-IN, ta-IN, kn-IN, ml-IN, pa-IN and
# ur-IN, and a free tier of ~1M characters/month.
# Create at: console.cloud.google.com -> APIs & Services -> Credentials ->
# Create API key, then enable "Cloud Text-to-Speech API". Restrict the key to
# that single API.
#
# COST: the free tier is monthly and recurring (~1M characters for Wavenet /
# Neural2, ~4M for Standard), but it is NOT a hard cap — going over bills the
# account. Set a budget alert in Cloud Console -> Billing -> Budgets & alerts.
# Studio and Chirp voices are never selected automatically because they cost
# roughly 10x more; set GOOGLE_TTS_VOICE explicitly if you want one.
GOOGLE_TTS_API_KEY=
# Optional. Blank = auto-pick the best affordable voice for each language.
GOOGLE_TTS_VOICE=

# ElevenLabs — great English voices, but on the FREE plan the Voice Library is
# blocked, leaving only English-native voices. Those read Gujarati/Hindi text
# with English pronunciation: it sounds fluent but is not the language. Only
# worth enabling for English, or on a paid plan with an Indic voice.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=pFZP5JQG7iQjIQuC4Bku
ELEVENLABS_MODEL_ID=eleven_v3

# e.g. "10/minute" — protects free LLM quota from abuse
SCAN_RATE_LIMIT=10/minute
CHAT_RATE_LIMIT=15/minute
TTS_RATE_LIMIT=20/minute
