# LLM providers (both free tier — Groq primary, Gemini fallback)
GROQ_API_KEY=
GEMINI_API_KEY=

# Supabase project settings → API
SUPABASE_URL=
# Service role key — backend only, NEVER expose to frontend/browser
SUPABASE_SERVICE_ROLE_KEY=
# Project settings → API → JWT Settings → JWT Secret (used to verify tokens issued to the frontend)
SUPABASE_JWT_SECRET=

# Comma-separated list of allowed frontend origins, no wildcard
ALLOWED_ORIGINS=http://localhost:5173

# --- Text-to-speech (all optional) ---
# With nothing set here, read-aloud uses the browser's own voices. Any failure
# at any point also falls back to the browser voice, so this is safe to leave
# blank.
# "auto" = prefer Sarvam, then Google, then ElevenLabs, else disabled.
# Force one with: sarvam | google | elevenlabs
TTS_PROVIDER=auto

# --- Sarvam AI (RECOMMENDED — built for Indian languages) ---
# Covers gu, hi, mr, bn, ta, te, kn, ml, pa and Odia (which Google and
# ElevenLabs do not speak at all). No Urdu — that falls back to the browser.
# Signup needs NO credit card and includes one-off free credits that don't
# expire. Get a key at dashboard.sarvam.ai
SARVAM_API_KEY=
# v3 is clearer than v2 on Gujarati — chosen by listening to both.
SARVAM_MODEL=bulbul:v3
# Blank = Sarvam's default voice for the model. v2 voices include anushka,
# manisha, vidya, arya (female) and abhilash, karun, hitesh (male).
SARVAM_SPEAKER=
# Below 1.0 reads slower than natural speech — helps clarity for listeners
# hearing safety instructions under stress.
SARVAM_PACE=0.9
SARVAM_SAMPLE_RATE=24000

# Languages served by the device's own voice instead of the paid provider,
# comma-separated. English is the default: every platform ships a good English
# voice, while Indic voice packs are often missing entirely — so credits are
# worth spending only where the device would otherwise fail. Set to "" (empty)
# to send every language to the provider.
TTS_BROWSER_LANGUAGES=en

# --- Speech-to-text ---
# "auto" = Sarvam when SARVAM_API_KEY is set, else local faster-whisper.
# Whisper's `base` model (the largest that fits Render's 512MB tier) cannot
# transcribe Gujarati — it returns Devanagari with garbled words — so Sarvam is
# strongly preferred for Indic voice input. Whisper remains the fallback.
STT_PROVIDER=auto
SARVAM_STT_MODEL=saaras:v3

# Google Cloud TTS — RECOMMENDED for this app. It has real native-speaker
# neural voices for gu-IN, hi-IN, mr-IN, bn-IN, ta-IN, kn-IN, ml-IN, pa-IN and
# ur-IN, and a free tier of ~1M characters/month.
# Create at: console.cloud.google.com -> APIs & Services -> Credentials ->
# Create API key, then enable "Cloud Text-to-Speech API". Restrict the key to
# that single API.
#
# COST: the free tier is monthly and recurring (~1M characters for Wavenet /
# Neural2, ~4M for Standard), but it is NOT a hard cap — going over bills the
# account. Set a budget alert in Cloud Console -> Billing -> Budgets & alerts.
# Studio and Chirp voices are never selected automatically because they cost
# roughly 10x more; set GOOGLE_TTS_VOICE explicitly if you want one.
GOOGLE_TTS_API_KEY=
# Optional. Blank = auto-pick the best affordable voice for each language.
GOOGLE_TTS_VOICE=

# ElevenLabs — great English voices, but on the FREE plan the Voice Library is
# blocked, leaving only English-native voices. Those read Gujarati/Hindi text
# with English pronunciation: it sounds fluent but is not the language. Only
# worth enabling for English, or on a paid plan with an Indic voice.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=pFZP5JQG7iQjIQuC4Bku
ELEVENLABS_MODEL_ID=eleven_v3

# e.g. "10/minute" — protects free LLM quota from abuse
SCAN_RATE_LIMIT=10/minute
CHAT_RATE_LIMIT=15/minute
TTS_RATE_LIMIT=20/minute
